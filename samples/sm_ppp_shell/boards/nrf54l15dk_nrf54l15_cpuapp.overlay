/*
 * See nRF54L15DK GPIO documentation from
 * https://docs.nordicsemi.com/bundle/ug_nrf54l15_dk/page/UG/nRF54L15_DK/hw_desription/connector_if.html
 *
 * UART22 is used for Serial Modem communication with the same pinout as the
 * OSS_ZEPHYR host application. UART20 remains routed to VCOM1 for console/shell.
 */

/ {
	chosen {
		/* Switch console to uart20 */
		zephyr,console = &uart20;
		zephyr,shell-uart = &uart20;
	};
	aliases {
		modem = &modem;
	};
};

&pinctrl {
	uart22_modem_default: uart22_modem_default {
		group1 {
			psels = <NRF_PSEL(UART_RX, 1, 13)>,
				<NRF_PSEL(UART_CTS, 1, 14)>;
			bias-pull-up;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>,
				<NRF_PSEL(UART_RTS, 1, 11)>;
		};
	};

	uart22_modem_sleep: uart22_modem_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>,
				<NRF_PSEL(UART_RX, 1, 13)>,
				<NRF_PSEL(UART_RTS, 1, 11)>,
				<NRF_PSEL(UART_CTS, 1, 14)>;
			low-power-enable;
		};
	};
};

/* These board resources conflict with the OSS_ZEPHYR modem wiring. */
&button0 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

&uart30 {
	status = "disabled";
};

/* Zephyr modem UART <-> nRF91 Serial Modem UART */
&uart22 {
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart22_modem_default>;
	pinctrl-1 = <&uart22_modem_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,pm-device-runtime-auto;

	/* Nordic nRF91 Serial Modem configuration */
	modem: modem {
		compatible = "nordic,nrf91-sm-v2";
		status = "okay";
		mdm-ring-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		mdm-dtr-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		zephyr,pm-device-runtime-auto;
		cmux-enable-runtime-power-save;
		cmux-close-pipe-on-power-save;
		cmux-idle-timeout-ms = <5000>;
		autostarts;
	};
};

&gpio0 {
	status = "okay";
};

/* Using default SRAM partitions from nrf54l15_cpuapp_partition.dtsi */

/*
 * RRAM partition layout for nRF54L15 DK (disable MCUboot)
 *
 * 0x0000_0000  slot0 (primary app)          (1492 kB)
 * 0x0017_5000  Non-secure storage           ( 32 kB)
 */

/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

&cpuapp_rram {
	partitions {
		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x0 DT_SIZE_K(1492)>;
		};

		storage_partition: partition@175000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000175000 DT_SIZE_K(32)>;
		};
	};
};

/*
 * Use external flash for littlefs storage.
 */
/ {
	fstab {
		compatible = "zephyr,fstab";

		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_part>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		lfs_part: partition@0 {
			label = "littlefs";
			reg = <0x00000000 DT_SIZE_M(8)>;
		};
	};
};
