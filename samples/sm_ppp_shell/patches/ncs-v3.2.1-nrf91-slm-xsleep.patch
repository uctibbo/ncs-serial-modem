@@ -778,0 +779,5 @@
+#if defined(CONFIG_HOST_POWER_PROFILE_XSLEEP)
+		/* Opening UART asserts DTR; wait for Ready or the startup timeout. */
+		modem_cellular_enter_state(data, MODEM_CELLULAR_STATE_AWAIT_POWER_ON);
+		break;
+#endif
@@ -1345,0 +1351,10 @@
+#if defined(CONFIG_HOST_POWER_PROFILE_XSLEEP)
+		/* The nRF91 SLM must receive XSLEEP while its AT DLCI is still open. */
+		if (config->shutdown_chat_script != NULL && data->cmd_pipe != NULL) {
+			/* SLM returns its AT channel to DLCI 1 when PPP stops. */
+			data->cmd_pipe = data->dlci1_pipe;
+			modem_cellular_enter_state(
+				data, MODEM_CELLULAR_STATE_RUN_SHUTDOWN_SCRIPT);
+			break;
+		}
+#endif
@@ -1451,0 +1467,4 @@
+#if defined(CONFIG_HOST_POWER_PROFILE_XSLEEP)
+		/* Restore a known raw-AT state before a later resume attempt. */
+		modem_cellular_enter_state(data, MODEM_CELLULAR_STATE_INIT_POWER_OFF);
+#else
@@ -1454 +1473 @@
-
+#endif
@@ -1458 +1476,0 @@
