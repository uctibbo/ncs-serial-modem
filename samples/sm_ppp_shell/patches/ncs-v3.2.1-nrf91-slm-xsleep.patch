+			 modem_cellular_chat_callback_handler, 15);
+
+#define NORDIC_NRF91_SLM_SHUTDOWN_CHAT_SCRIPT (&nordic_nrf91_slm_shutdown_chat_script)
+#else
+#define NORDIC_NRF91_SLM_SHUTDOWN_CHAT_SCRIPT NULL
